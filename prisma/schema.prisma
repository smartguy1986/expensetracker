datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  email           String?  @unique
  password        String?
  image           String?
  themePreference String   @default("light") // "dark" or "light"
  accentColor     String   @default("#8b5cf6") // Default purple
  currency        String   @default("USD")
  lastLoginAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccounts BankAccount[]
  expenses     Expense[]
  incomes      Income[]
  creditCardAccounts CreditCardAccount[]
  fixedExpenses FixedExpense[]
  variableExpenses VariableExpense[]
  loans        Loan[]
  retirementInvestments RetirementInvestment[]
  investments  Investment[]
}

model BankAccount {
  id               String   @id @default(cuid())
  userId           String
  nickname         String
  encryptedDetails String   // Encrypted string containing account number/bank details
  balance          Float    @default(0.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "fixed", "variable", "loans", "credit cards", "emis", "Investments Fixed", "Investments Retirement"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  title       String
  categoryName String?
  subCategory String?
  monthlyCost Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Income {
  id          String   @id @default(cuid())
  userId      String
  title       String
  categoryName String?
  amount      Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditCardAccount {
  id        String   @id @default(cuid())
  userId    String
  bankName  String   // e.g., HDFC
  last4     String   // e.g., 1234
  expiry    String   // e.g., 12/28
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditCardTransaction[]
}

model CreditCardTransaction {
  id           String   @id @default(cuid())
  accountId    String
  isEmi        Boolean  @default(false)
  title        String
  
  // Base fields
  amount       Float    // Regular expense amount OR Total Loan amount if EMI
  date         DateTime // Date of expense OR Start date of EMI
  
  // EMI specific fields (nullable if isEmi is false)
  interestRate Float?   
  tenure       Int?     // Months
  monthlyEmi   Float?
  paidMonths   String   @default("[]") // JSON string array of paid month indices

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account CreditCardAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model FixedExpense {
  id        String   @id @default(cuid())
  userId    String
  name      String   // E.g., "Electric Bill"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries FixedExpenseEntry[]
}

model FixedExpenseEntry {
  id             String   @id @default(cuid())
  fixedExpenseId String
  month          String   // Format: "YYYY-MM" (e.g. "2026-08")
  amount         Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fixedExpense FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
}

model VariableExpense {
  id        String   @id @default(cuid())
  userId    String
  name      String   // E.g., "Groceries", "Dining Out"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries VariableExpenseEntry[]
}

model VariableExpenseEntry {
  id                String   @id @default(cuid())
  variableExpenseId String
  month             String   // Format: "YYYY-MM" (e.g. "2026-08")
  amount            Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variableExpense VariableExpense @relation(fields: [variableExpenseId], references: [id], onDelete: Cascade)
}

model Loan {
  id                String   @id @default(cuid())
  userId            String
  title             String
  provider          String
  totalAmount       Float
  interestRate      Float
  startDate         DateTime
  totalTenureMonths Int
  interestOnlyMonths Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RetirementInvestment {
  id                String   @id @default(cuid())
  userId            String
  name              String
  type              String   // PPF, NPS, Mutual Fund, LIC, etc.
  startDate         DateTime
  fundName          String?  // Optional, mostly for Mutual Funds
  provider          String
  paymentTerms      String   // Monthly, Quarterly, Half Yearly, Yearly
  installmentAmount Float
  currentValue      Float    @default(0.0)
  totalWithdrawn    Float    @default(0.0)
  paidTerms         String   @default("[]") // JSON string array of paid term indices
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Investment {
  id                String   @id @default(cuid())
  userId            String
  name              String
  type              String   // Mutual Fund, Stock, Fixed Deposit, etc.
  startDate         DateTime
  provider          String
  currentValue      Float    @default(0.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]
}

model InvestmentTransaction {
  id                String   @id @default(cuid())
  investmentId      String
  type              String   // "DEPOSIT" | "WITHDRAWAL"
  amount            Float
  date              DateTime
  createdAt         DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}
