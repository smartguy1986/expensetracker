{
  "name": "expensetracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ \"$VERCEL\" = \"1\" ]; then sed -i 's/provider = \"sqlite\"/provider = \"postgresql\"/g' prisma/schema.prisma && prisma generate && npx prisma db push --accept-data-loss; else prisma generate; fi && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "lucide-react": "^1.42.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^18",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
